+  gap: var(--space-6);
+}
+
+.sync-results__intro {
+  display: grid;
+  gap: var(--space-2);
+}
+
+.sync-results__intro h1,
+.sync-results__intro p,
+.sync-output__result p,
+.sync-output__expiry {
+  margin: 0;
+}
+
+.sync-results__filters {
+  display: grid;
+  grid-template-columns: minmax(8rem, 0.5fr) minmax(12rem, 1fr) auto;
+  align-items: end;
+  width: 100%;
+  max-width: none;
+  gap: var(--space-2);
+}
+
+.sync-results__filters label:nth-of-type(2) {
+  grid-column: 2;
+}
+
+.sync-results__filters select,
+.sync-results__filters input,
+.sync-results__dialog textarea {
+  min-height: var(--control-min-size);
+  padding: var(--space-2) var(--space-3);
+  border: var(--border-structural);
+  border-radius: var(--radius-control);
+  color: var(--color-text-main);
+  background: var(--color-surface);
+  box-shadow: var(--shadow-recessed);
+}
+
+.sync-results__filters select {
+  grid-column: 1;
+}
+
+.sync-results__filters input {
+  grid-column: 2;
+}
+
+.sync-results__filters button {
+  grid-column: 3;
+  grid-row: 2;
+}
+
+.sync-results__table-region {
+  width: 100%;
+  max-width: 100%;
+  overflow-x: auto;
+  border: var(--border-structural);
+  border-radius: var(--radius-control);
+  box-shadow: var(--shadow-recessed);
+}
+
+.sync-results__table {
+  width: 100%;
+  min-width: 72rem;
+  border-collapse: collapse;
+  background: var(--color-surface);
+}
+
+.sync-results__table th,
+.sync-results__table td {
+  padding: var(--space-3);
+  border-bottom: var(--border-structural);
+  text-align: left;
+  vertical-align: top;
+}
+
+.sync-results__table th {
+  color: var(--color-text-secondary-accessible);
+  font-size: var(--font-size-sm);
+}
+
+.sync-results__table tr:last-child td {
+  border-bottom: 0;
+}
+
+.sync-results__table code,
+.sync-results__dialog code {
+  font-family: "JetBrains Mono", Consolas, monospace;
+}
+
+.sync-results__pagination {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-3);
+}
+
+.sync-results__pagination span {
+  margin-right: auto;
+  color: var(--color-text-secondary-accessible);
+}
+
+.sync-results__dialog-backdrop {
+  position: fixed;
+  z-index: 10;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: var(--space-4);
+  background: rgb(39 49 58 / 0.34);
+}
+
+.sync-results__dialog {
+  display: grid;
+  gap: var(--space-4);
+  width: min(100%, 32rem);
+  max-height: calc(100dvh - var(--space-8));
+  overflow-y: auto;
+  padding: var(--space-6);
+  border: var(--border-structural);
+  border-radius: var(--radius-control);
+  color: var(--color-text-main);
+  background: var(--color-surface);
+  box-shadow: var(--shadow-raised);
+}
+
+.sync-results__dialog h2,
+.sync-results__dialog p {
+  margin: 0;
+}
+
+.sync-results__dialog-close {
+  justify-self: end;
+  min-height: var(--control-min-size);
+  padding: var(--space-2) var(--space-3);
+  border: var(--border-structural);
+  border-radius: var(--radius-control);
+  color: var(--color-text-main);
+  background: var(--color-surface);
+  box-shadow: var(--shadow-raised);
+  cursor: pointer;
+}
+
+.sync-results__dialog form,
+.sync-results__dialog fieldset {
+  display: grid;
+  gap: var(--space-3);
+  width: 100%;
+  max-width: none;
+}
+
+.sync-results__dialog fieldset {
+  padding: var(--space-3);
+  border: var(--border-structural);
+  border-radius: var(--radius-control);
+}
+
+.sync-results__dialog textarea {
+  min-height: 6rem;
+  resize: vertical;
+}
+
+.sync-results__error {
+  margin: 0;
+  color: var(--color-danger);
+}
+
+.sync-output__result {
+  display: grid;
+  justify-items: start;
+  gap: var(--space-3);
+  width: 100%;
+  padding: var(--space-4);
+  border: var(--border-structural);
+  border-radius: var(--radius-control);
+  box-shadow: var(--shadow-raised);
+}
+
+.sync-output__expiry {
+  color: var(--color-text-secondary-accessible);
+  font-size: var(--font-size-sm);
+}
+
 .sync-progress__meter progress {
   width: 100%;
   height: var(--space-3);
