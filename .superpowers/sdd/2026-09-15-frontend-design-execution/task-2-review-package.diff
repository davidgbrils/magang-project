+
+export interface StatusBadgeProps {
+  tone?: StatusTone;
+  children: ReactNode;
+}
+
+export function StatusBadge({ tone = "neutral", children }: StatusBadgeProps) {
+  return (
+    <span className="ui-status-badge" data-tone={tone}>
+      {children}
+    </span>
+  );
+}
